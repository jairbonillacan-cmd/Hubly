# Webhook que recibe cada registro de la lista de espera como JSON: { "email", "signedUpAt" }
# Sin este valor, el formulario avisa de que la lista aún no está abierta.
WAITLIST_WEBHOOK_URL=

# Supabase. Sin estos valores la app corre en modo demo, con datos locales y sin cuentas.
# Se obtienen en Project Settings > API. Nunca pongas aquí la clave service_role o secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
